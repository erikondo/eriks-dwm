+static void
+rllog(const char *fmt, ...)
+{
+	static FILE *f = NULL;
+	va_list ap;
+	struct timespec ts;
+
+	if (!f && !(f = fopen("/tmp/dwm-deck.log", "a")))
+		return;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	fprintf(f, "[%ld.%03ld] ", ts.tv_sec, ts.tv_nsec / 1000000);
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fprintf(f, "\n");
+	fflush(f);
+}
+
 static void
 rlexpose(Window w)
 {
